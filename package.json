{
  "name": "graphql-react",
  "private": true,
  "version": "0.0.0",
  "repository": "git@github.com:eddeee888/graphql-react-template.git",
  "author": "Eddy Nguyen <ch@eddeee888.me>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start:server": "vite",
    "start:codegen": "graphql-codegen --watch",
    "dev": "run-p -l start:codegen start:server",
    "codegen": "graphql-codegen",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@apollo/client": "4.3.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "graphql": "17.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eddeee888/eslint-plugin": "1.0.1",
    "@graphql-codegen/cli": "7.2.0",
    "@parcel/watcher": "2.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0"
    }
  }
}
